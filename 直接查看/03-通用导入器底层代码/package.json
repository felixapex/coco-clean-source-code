{
  "name": "matbox-importer-core",
  "version": "2.9.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13 <23"
  },
  "dependencies": {
    "pngjs": "7.0.0"
  },
  "devDependencies": {
    "typescript": "5.9.3"
  },
  "scripts": {
    "test": "node --test --test-concurrency=1 tests/*.test.mjs",
